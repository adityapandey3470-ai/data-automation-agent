# =============================================
# .gitignore — Java / Spring Boot / IntelliJ / Maven
# =============================================

# ----- Build output -----
target/

# ----- IntelliJ IDEA -----
.idea/
*.iml
*.iws
*.ipr
out/

# ----- Eclipse -----
.classpath
.project
.settings/

# ----- VS Code -----
.vscode/

# ----- OS generated -----
.DS_Store
Thumbs.db

# ----- Environment / secrets -----
.env
*.env
.env.*
application-local.yml
application-secret.yml

# ----- Logs & Data -----
*.log
logs/
data/
*.mv.db
*.trace.db

# ----- Frontend -----
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ----- Maven Wrapper (optional) -----
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
