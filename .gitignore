# =============================================
# .gitignore — Java / Spring Boot / IntelliJ / Maven
# =============================================

# ----- Build output -----
target/

# ----- IntelliJ IDEA -----
.idea/
*.iml
*.iws
*.ipr
out/

# ----- Eclipse -----
.classpath
.project
.settings/

# ----- VS Code -----
.vscode/

# ----- OS generated -----
.DS_Store
Thumbs.db

# ----- Environment / secrets -----
.env
*.env
.env.*
application-local.yml
application-secret.yml

# ----- Logs -----
*.log
logs/

# ----- Maven Wrapper (optional) -----
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
